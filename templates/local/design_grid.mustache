{{!
    @template format_customtiles/local/design_grid

    Design view of the course page in edit mode: every section as a tile with its appearance controls.

    Example context (json):
    {
        "contextid": 12,
        "designtiles": [
            {"id": 4, "num": 1, "displaynum": "1", "name": "Section", "visible": true, "activitieslabel": "3 activities"}
        ]
    }
}}
<ul class="fct-tiles fct-design" data-region="fct-design" data-contextid="{{contextid}}">
    {{#designtiles}}
        <li class="fct-tile fct-item fct-designtile" data-section-id="{{id}}" data-region="fct-designtile">
            {{> format_customtiles/local/design_tile }}
        </li>
    {{/designtiles}}
</ul>
