{{!
    @template format_customtiles/local/catbadge

    Activity category badge: code and icon, with the full name for assistive technology.

    Example context (json):
    {
        "code": "AF", "name": "Training activity", "label": "Category: Training activity",
        "style": "--ct-cat-bg:#1d4ed8;--ct-cat-fg:#ffffff", "hasicon": true, "icon": "book-open"
    }
}}
<span class="ct-catbadge" style="{{style}}" title="{{name}}">
    {{#hasicon}}<i class="fa-solid fa-{{icon}}" aria-hidden="true"></i>{{/hasicon}}
    <span aria-hidden="true">{{code}}</span>
    <span class="visually-hidden">{{label}}</span>
</span>
