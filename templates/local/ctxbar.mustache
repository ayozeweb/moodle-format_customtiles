{{!
    @template format_customtiles/local/ctxbar

    Always visible context line and quick access to the course map.

    Example context (json):
    {
        "parts": [{"text": "Module 2", "last": false}, {"text": "Activity 4 of 9", "last": true}],
        "mapurl": "#"
    }
}}
<nav class="fct-ctxbar" aria-label="{{#str}} contextinfo, format_customtiles {{/str}}">
    <p class="fct-ctxbar__text">
        {{#parts}}<span class="fct-ctxbar__part">{{text}}</span>{{^last}} <span aria-hidden="true">·</span> {{/last}}{{/parts}}
    </p>
    <a class="fct-ctxbar__map" href="{{mapurl}}"><i class="fa-solid fa-sitemap" aria-hidden="true"></i> {{#str}} coursemap, format_customtiles {{/str}}</a>
</nav>
