{{!
    @template format_customtiles/local/section_header

    Header of the focused section page: cover or colour, subtitle, time, progress and state.
    The section name is not repeated: the theme prints it as the page heading.

    Example context (json):
    {
        "id": 4, "num": 2, "state": "inprogress", "statelabel": "In progress",
        "stateicon": "fa-circle-half-stroke", "subtitle": "First steps", "timelabel": "1 h 30 min",
        "activitieslabel": "3 activities", "hasprogress": true, "percent": 33,
        "progresslabel": "1 of 3 completed", "hasicon": true, "icon": "flask",
        "hascolor": true, "coverstyle": "--fct-c1:#0e7490;--fct-c2:#155e75;--fct-fg:#ffffff"
    }
}}
<div class="fct-sechead fct-item" data-section-id="{{id}}">
    <div class="fct-sechead__cover{{#hascolor}} fct-has-color{{/hascolor}}" aria-hidden="true"
         style="--fct-vt: fct-cover-{{id}};{{#hascolor}}{{coverstyle}}{{/hascolor}}">
        {{> format_customtiles/local/cover }}
    </div>
    <div class="fct-sechead__body">
        {{#subtitle}}<p class="fct-sechead__subtitle">{{subtitle}}</p>{{/subtitle}}
        <p class="fct-item__meta">{{activitieslabel}}{{#timelabel}} · <i class="fa-regular fa-clock" aria-hidden="true"></i> <span class="visually-hidden">{{#str}} estimatedtime, format_customtiles {{/str}}</span>{{timelabel}}{{/timelabel}}</p>
        {{#hasprogress}}
            <div class="fct-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                 aria-valuenow="{{percent}}" aria-label="{{progresslabel}}">
                <span class="fct-progress__bar" style="--fct-pct: {{percent}}%"></span>
            </div>
        {{/hasprogress}}
        <div class="fct-sechead__row">
            <p class="fct-state fct-state--{{state}}"><i class="fa-solid {{stateicon}}" aria-hidden="true"></i> <span>{{statelabel}}</span></p>
            {{#hasprogress}}<p class="fct-item__meta">{{progresslabel}}</p>{{/hasprogress}}
        </div>
    </div>
</div>
