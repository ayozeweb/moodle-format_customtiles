{{!
    @template format_customtiles/local/tile_body

    Shared body of a section item (title, summary, meta, progress, state) used by every layout.

    Example context (json):
    {
        "name": "Section", "url": "#", "locked": false, "state": "inprogress",
        "statelabel": "In progress", "stateicon": "fa-circle-half-stroke",
        "subtitle": "Subtitle", "timelabel": "25 min", "summary": "Summary", "activitieslabel": "3 activities", "hasprogress": true,
        "percent": 33, "progresslabel": "1 of 3 completed", "reason": ""
    }
}}
<h3 class="fct-item__title">
    {{#locked}}<span class="fct-item__name">{{{name}}}</span>{{/locked}}
    {{^locked}}<a class="fct-item__link" href="{{url}}">{{{name}}}</a>{{/locked}}
</h3>
{{#subtitle}}<p class="fct-item__subtitle">{{subtitle}}</p>{{/subtitle}}
{{#summary}}<p class="fct-item__summary">{{summary}}</p>{{/summary}}
{{#locked}}<div class="fct-item__reason">{{{reason}}}</div>{{/locked}}
<p class="fct-item__meta">{{activitieslabel}}{{#timelabel}} · <i class="fa-regular fa-clock" aria-hidden="true"></i> <span class="visually-hidden">{{#str}} estimatedtime, format_customtiles {{/str}}</span>{{timelabel}}{{/timelabel}}</p>
{{#hasprogress}}
    <div class="fct-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
         aria-valuenow="{{percent}}" aria-label="{{progresslabel}}">
        <span class="fct-progress__bar" style="--fct-pct: {{percent}}%"></span>
    </div>
    <p class="fct-item__meta">{{progresslabel}}</p>
{{/hasprogress}}
<p class="fct-state fct-state--{{state}}"><i class="fa-solid {{stateicon}}" aria-hidden="true"></i> <span>{{statelabel}}</span></p>
