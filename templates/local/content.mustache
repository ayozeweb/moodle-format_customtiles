{{!
    @template format_customtiles/local/content

    Course page: skin wrapper, hero and the selected layout. In edit mode (or inside a
    section) the core content is rendered so the reactive editor keeps working.

    Example context (json):
    {
        "skin": "light",
        "tokens": "--ct-primary:#1d4ed8",
        "layout": "tiles",
        "isindex": true,
        "mapurl": "#",
        "hasctx": true,
        "parts": [{"text": "Section", "last": true}],
        "haslogos": true,
        "logos": [{"src": "#", "alt": "Logo"}],
        "haslegend": true,
        "legend": [{"code": "AF", "name": "Training activity", "style": "--ct-cat-bg:#1d4ed8;--ct-cat-fg:#ffffff"}],
        "showtiles": true,
        "hastiles": true,
        "tilecount": 1,
        "variants": [{"cssclass": "", "istiles": true}],
        "hero": {
            "title": "Example course",
            "summary": "A short description.",
            "hasprogress": true,
            "percent": 40,
            "ringoffset": 60,
            "progresslabel": "2 of 5 completed",
            "haspills": true,
            "pills": [{"icon": "fa-layer-group", "text": "6 sections"}],
            "continue": {"url": "#", "name": "Activity"},
            "continuelabel": "Continue where you left off"
        },
        "tiles": [
            {
                "id": 1, "num": 1, "name": "Section", "url": "#", "state": "inprogress",
                "statelabel": "In progress", "stateicon": "fa-circle-half-stroke",
                "summary": "Summary", "activitieslabel": "3 activities", "hasprogress": true,
                "percent": 33, "progresslabel": "1 of 3 completed"
            }
        ]
    }
}}
<div class="ct-root" data-ct-skin="{{skin}}" data-ct-layout="{{layout}}" style="{{tokens}}">
    {{#hasctx}}
        {{> format_customtiles/local/ctxbar }}
    {{/hasctx}}
    {{#isindex}}
        {{#hero}}
            {{> format_customtiles/local/hero }}
        {{/hero}}
    {{/isindex}}
    {{#showtiles}}
        <div class="ct-main" id="ct-main">
            <h2 class="accesshide">{{{title}}}</h2>
            {{#hastiles}}
                {{#variants}}
                    <div class="ct-variant {{cssclass}}">
                        {{#istiles}}{{> format_customtiles/local/layout_tiles }}{{/istiles}}
                        {{#iscards}}{{> format_customtiles/local/layout_cards }}{{/iscards}}
                        {{#ispath}}{{> format_customtiles/local/layout_path }}{{/ispath}}
                        {{#iscarousel}}{{> format_customtiles/local/layout_carousel }}{{/iscarousel}}
                    </div>
                {{/variants}}
            {{/hastiles}}
        </div>
        {{#js}}
            require(['core_courseformat/local/content'], function(component) {
                component.init('#page', {}, null, null);
            });
            {{#hascarousel}}
            require(['format_customtiles/carousel'], function(carousel) {
                carousel.init();
            });
            {{/hascarousel}}
        {{/js}}
    {{/showtiles}}
    {{^showtiles}}
        {{> core_courseformat/local/content }}
    {{/showtiles}}
    {{#haslogos}}
        <div class="ct-strip" role="group" aria-label="{{#str}} logosaria, format_customtiles {{/str}}">
            {{#logos}}<img src="{{src}}" alt="{{alt}}" height="48" loading="lazy">{{/logos}}
        </div>
    {{/haslogos}}
    {{#haslegend}}
        <details class="ct-legend">
            <summary>{{#str}} legendtitle, format_customtiles {{/str}}</summary>
            <ul class="ct-legend__list" aria-label="{{#str}} legend, format_customtiles {{/str}}">
                {{#legend}}
                    <li>
                        <span class="ct-catbadge" style="{{style}}">
                            {{#hasicon}}<i class="fa-solid fa-{{icon}}" aria-hidden="true"></i>{{/hasicon}}
                            {{code}}
                        </span>
                        {{name}}
                    </li>
                {{/legend}}
            </ul>
        </details>
    {{/haslegend}}
</div>
