{{!
    @template format_customtiles/local/content

    Course page: skin wrapper around the core course content.

    Example context (json):
    {
        "skin": "light",
        "tokens": "--ct-primary:#1d4ed8",
        "layout": "tiles",
        "isindex": true,
        "coursename": "Example course"
    }
}}
<div class="ct-root" data-ct-skin="{{skin}}" data-ct-layout="{{layout}}" style="{{tokens}}">
    {{> core_courseformat/local/content }}
</div>
