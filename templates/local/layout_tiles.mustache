{{!
    @template format_customtiles/local/layout_tiles

    Responsive grid of section tiles.

    Example context (json):
    {
        "tiles": [
            {
                "id": 1, "num": 1, "name": "Section", "url": "#", "state": "inprogress",
                "statelabel": "In progress", "stateicon": "fa-circle-half-stroke",
                "summary": "Summary", "activitieslabel": "3 activities", "hasprogress": true,
                "percent": 33, "progresslabel": "1 of 3 completed"
            }
        ]
    }
}}
<ul class="ct-tiles{{#isbento}} ct-tiles--bento{{/isbento}}" data-for="ct_tiles">
    {{#tiles}}
        <li class="ct-tile ct-item ct-tile--{{state}}{{#iscurrent}} ct-tile--current{{/iscurrent}}" data-section-id="{{id}}">
            <div class="ct-tile__cover{{#hascolor}} ct-has-color{{/hascolor}}" aria-hidden="true"{{#hascolor}} style="{{coverstyle}}"{{/hascolor}}>
                {{> format_customtiles/local/cover }}
            </div>
            <div class="ct-tile__body">
                {{> format_customtiles/local/tile_body }}
            </div>
        </li>
    {{/tiles}}
</ul>
