{{!
    @template format_customtiles/local/map

    Course map: every section and activity with its state, printable.

    Example context (json):
    {
        "title": "Example course",
        "courseurl": "#",
        "hasoverall": true,
        "overalllabel": "2 of 5 completed",
        "overall": {"percent": 40},
        "sections": [
            {
                "name": "Section 1", "url": "#", "state": "inprogress", "statelabel": "In progress",
                "stateicon": "fa-circle-half-stroke", "locked": false, "hasactivities": true,
                "activitylist": [{"name": "Page", "url": "#", "icon": "#", "tracked": true, "done": true,
                    "statelabel": "Completed"}]
            }
        ]
    }
}}
<div class="fct-root fct-map">
    <p><a href="{{courseurl}}">{{#str}} backtocourse, format_customtiles {{/str}}</a></p>
    <h2 class="fct-map__title">{{#str}} coursemap, format_customtiles {{/str}}</h2>
    {{#hasoverall}}<p>{{#str}} overallprogress, format_customtiles {{/str}}: {{overall.percent}}% ({{overalllabel}})</p>{{/hasoverall}}
    <ol class="fct-map__sections">
        {{#sections}}
            <li class="fct-map__section">
                <h3 class="fct-map__sectiontitle">
                    {{#locked}}{{{name}}}{{/locked}}
                    {{^locked}}<a href="{{url}}">{{{name}}}</a>{{/locked}}
                    <span class="fct-state fct-state--{{state}}"><i class="fa-solid {{stateicon}}" aria-hidden="true"></i> {{statelabel}}</span>
                </h3>
                {{#locked}}<div class="fct-item__reason">{{{reason}}}</div>{{/locked}}
                {{#hasactivities}}
                    <ul class="fct-map__activities">
                        {{#activitylist}}
                            <li>
                                <img src="{{icon}}" alt="" width="20" height="20">
                                <a href="{{url}}">{{{name}}}</a>
                                {{#tracked}}<span class="fct-state fct-state--{{#done}}completed{{/done}}{{^done}}pending{{/done}}">{{statelabel}}</span>{{/tracked}}
                            </li>
                        {{/activitylist}}
                    </ul>
                {{/hasactivities}}
            </li>
        {{/sections}}
    </ol>
</div>
