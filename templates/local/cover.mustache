{{!
    @template format_customtiles/local/cover

    Decorative cover content of a section: image, or icon and number.

    Example context (json):
    {
        "num": 2,
        "hascover": false,
        "hasicon": true,
        "icon": "flask"
    }
}}
{{#hascover}}
    <img class="fct-cover__img" src="{{coversrc}}" srcset="{{coversrcset}}" sizes="(min-width: 48rem) 480px, 50vw"
         alt="" width="480" height="300" loading="lazy" decoding="async">
    <span class="fct-cover__badge">{{num}}</span>
{{/hascover}}
{{^hascover}}
    {{#hasicon}}
        <i class="fa-solid fa-{{icon}} fct-cover__icon"></i>
        <span class="fct-cover__badge">{{num}}</span>
    {{/hasicon}}
    {{^hasicon}}
        <span class="fct-cover__num">{{num}}</span>
    {{/hasicon}}
{{/hascover}}
