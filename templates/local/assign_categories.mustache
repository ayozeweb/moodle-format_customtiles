{{!
    @template format_customtiles/local/assign_categories

    Teacher page: choose the category of each activity.

    Example context (json):
    {
        "hascategories": true,
        "intro": "Choose the category of each activity.",
        "formurl": "#",
        "sesskey": "abc",
        "sections": [
            {
                "name": "Section 1",
                "activities": [
                    {"id": 5, "name": "Page", "options": [
                        {"value": 0, "label": "No category", "selected": true},
                        {"value": 1, "label": "AF · Training activity", "selected": false}
                    ]}
                ]
            }
        ]
    }
}}
{{#hascategories}}
    <p>{{intro}}</p>
    <form method="post" action="{{formurl}}" class="ct-assign">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{#sections}}
            <h3 class="h5 mt-4">{{{name}}}</h3>
            {{#activities}}
                <div class="row align-items-center mb-2">
                    <label class="col-md-6 col-form-label" for="cat_{{id}}">{{{name}}}</label>
                    <div class="col-md-6">
                        <select class="form-select" id="cat_{{id}}" name="cat_{{id}}">
                            {{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
                        </select>
                    </div>
                </div>
            {{/activities}}
        {{/sections}}
        <button type="submit" class="btn btn-primary mt-3">{{#str}} savechanges, core {{/str}}</button>
    </form>
{{/hascategories}}
{{^hascategories}}
    <div class="alert alert-info">{{#str}} nocategoriesadmin, format_customtiles {{/str}}</div>
{{/hascategories}}
