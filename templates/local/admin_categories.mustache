{{!
    @template format_customtiles/local/admin_categories

    Administration page: list of activity categories with actions.

    Example context (json):
    {
        "intro": "Categories teachers assign to activities.",
        "hascategories": true,
        "categories": [
            {"code": "AF", "name": "Training activity", "color": "#1d4ed8", "style": "--ct-cat-bg:#1d4ed8;--ct-cat-fg:#ffffff",
             "editurl": "#", "deleteurl": "#"}
        ],
        "addurl": "#",
        "pageurl": "#",
        "sesskey": "abc"
    }
}}
<div class="ct-admin">
    <p>{{intro}}</p>
    {{#hascategories}}
        <table class="generaltable ct-admin__table">
            <caption class="visually-hidden">{{#str}} categoriesadmin, format_customtiles {{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} catcode, format_customtiles {{/str}}</th>
                    <th scope="col">{{#str}} catname, format_customtiles {{/str}}</th>
                    <th scope="col">{{#str}} catcolor, format_customtiles {{/str}}</th>
                    <th scope="col">{{#str}} catactions, format_customtiles {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#categories}}
                    <tr>
                        <td><span class="ct-catbadge" style="{{style}}">{{code}}</span></td>
                        <td>{{name}}</td>
                        <td>{{color}}</td>
                        <td>
                            <a href="{{editurl}}">{{#str}} edit, core {{/str}}</a> ·
                            <a href="{{deleteurl}}">{{#str}} delete, core {{/str}}</a>
                        </td>
                    </tr>
                {{/categories}}
            </tbody>
        </table>
    {{/hascategories}}
    {{^hascategories}}
        <div class="alert alert-info">{{#str}} nocategories, format_customtiles {{/str}}</div>
    {{/hascategories}}
    <div class="d-flex flex-wrap gap-2 mt-3">
        <a class="btn btn-primary" href="{{addurl}}">{{#str}} addcategory, format_customtiles {{/str}}</a>
        <form method="post" action="{{pageurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="sepe">
            <button type="submit" class="btn btn-secondary">{{#str}} loadsepe, format_customtiles {{/str}}</button>
        </form>
    </div>
</div>
