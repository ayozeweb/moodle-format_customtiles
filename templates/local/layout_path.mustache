{{!
    @template format_customtiles/local/layout_path

    Vertical learning path: connected steps with a visible state and lock.

    Example context (json):
    {
        "tiles": [
            {
                "id": 1, "num": 1, "position": 1, "name": "Section", "url": "#", "state": "completed",
                "iscompleted": true, "statelabel": "Completed", "stateicon": "fa-circle-check",
                "summary": "Summary", "activitieslabel": "3 activities", "hasprogress": true,
                "percent": 100, "progresslabel": "3 of 3 completed"
            },
            {
                "id": 2, "num": 2, "position": 2, "name": "Locked", "state": "locked", "islocked": true,
                "locked": true, "statelabel": "Locked", "stateicon": "fa-lock", "reason": "Complete step 1",
                "activitieslabel": "2 activities"
            }
        ]
    }
}}
<ol class="ct-path" data-for="ct_path">
    {{#tiles}}
        <li class="ct-step ct-item ct-step--{{state}}{{#iscurrent}} ct-step--current{{/iscurrent}}" data-section-id="{{id}}">
            <span class="ct-step__node" aria-hidden="true">
                {{#iscompleted}}<i class="fa-solid fa-check"></i>{{/iscompleted}}
                {{#islocked}}<i class="fa-solid fa-lock"></i>{{/islocked}}
                {{^iscompleted}}{{^islocked}}{{position}}{{/islocked}}{{/iscompleted}}
            </span>
            <div class="ct-step__card">
                {{> format_customtiles/local/tile_body }}
            </div>
        </li>
    {{/tiles}}
</ol>
