{{!
    @template format_customtiles/local/duechip

    Deadline chip of an activity: icon and text (never colour alone), with the exact date for assistive technology.

    Example context (json):
    {
        "state": "soon", "label": "Due in 3 days", "date": "19/11/26, 23:59", "icon": "fa-clock"
    }
}}
<span class="fct-due fct-due--{{state}}" title="{{date}}">
    <i class="fa-solid {{icon}}" aria-hidden="true"></i>
    <span>{{label}}</span>
    <span class="visually-hidden">({{date}})</span>
</span>
