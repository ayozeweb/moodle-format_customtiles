{{!
    @template format_customtiles/local/layout_list

    Compact list for courses with many sections.

    Example context (json):
    {
        "tiles": [
            {
                "id": 1, "num": 1, "name": "Section", "url": "#", "state": "inprogress",
                "statelabel": "In progress", "stateicon": "fa-circle-half-stroke",
                "activitieslabel": "3 activities", "hasprogress": true,
                "percent": 33, "progresslabel": "1 of 3 completed"
            }
        ]
    }
}}
<ol class="ct-list" data-for="ct_list">
    {{#tiles}}
        <li class="ct-row ct-item ct-row--{{state}}{{#iscurrent}} ct-row--current{{/iscurrent}}" data-section-id="{{id}}">
            <span class="ct-row__num" aria-hidden="true">{{num}}</span>
            <div class="ct-row__main">
                <h3 class="ct-item__title">
                    {{#locked}}<span class="ct-item__name">{{{name}}}</span>{{/locked}}
                    {{^locked}}<a class="ct-item__link" href="{{url}}">{{{name}}}</a>{{/locked}}
                </h3>
                {{#locked}}<div class="ct-item__reason">{{{reason}}}</div>{{/locked}}
                <p class="ct-item__meta">{{activitieslabel}}{{#timelabel}} · {{timelabel}}{{/timelabel}}</p>
                {{#hasprogress}}
                    <div class="ct-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="{{percent}}" aria-label="{{progresslabel}}">
                        <span class="ct-progress__bar" style="--ct-pct: {{percent}}%"></span>
                    </div>
                {{/hasprogress}}
            </div>
            <p class="ct-state ct-state--{{state}}"><i class="fa-solid {{stateicon}}" aria-hidden="true"></i> <span>{{statelabel}}</span></p>
        </li>
    {{/tiles}}
</ol>
