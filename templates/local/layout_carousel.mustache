{{!
    @template format_customtiles/local/layout_carousel

    Near full-screen sections that slide horizontally (scroll-snap) with buttons, a position
    indicator and keyboard support. Works without JavaScript through native scrolling.

    Example context (json):
    {
        "tilecount": 2,
        "tiles": [
            {
                "id": 1, "num": 1, "position": 1, "name": "Section", "url": "#", "state": "inprogress",
                "statelabel": "In progress", "stateicon": "fa-circle-half-stroke",
                "summary": "Summary", "activitieslabel": "3 activities", "hasprogress": true,
                "percent": 33, "progresslabel": "1 of 3 completed"
            }
        ]
    }
}}
<div class="ct-carousel" role="region" aria-roledescription="carousel" aria-label="{{#str}} carouselaria, format_customtiles {{/str}}"
     data-region="ct-carousel" data-count="{{tilecount}}">
    <ul class="ct-carousel__track" data-region="track" tabindex="0">
        {{#tiles}}
            <li class="ct-slide ct-item ct-slide--{{state}}{{#iscurrent}} ct-slide--current{{/iscurrent}}" data-section-id="{{id}}"
                role="group" aria-roledescription="slide"
                aria-label="{{#str}} slidex, format_customtiles, {"x": {{position}}, "n": {{tilecount}}} {{/str}}">
                <div class="ct-slide__cover" aria-hidden="true">
                    <span class="ct-slide__num">{{num}}</span>
                </div>
                <div class="ct-slide__body">
                    {{> format_customtiles/local/tile_body }}
                </div>
            </li>
        {{/tiles}}
    </ul>
    <div class="ct-carousel__nav" data-region="nav" hidden>
        <button type="button" class="ct-iconbtn" data-action="prev" aria-label="{{#str}} prevslide, format_customtiles {{/str}}">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <ol class="ct-carousel__dots" data-region="dots"></ol>
        <button type="button" class="ct-iconbtn" data-action="next" aria-label="{{#str}} nextslide, format_customtiles {{/str}}">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </button>
    </div>
    <p class="accesshide" aria-live="polite" data-region="status"></p>
</div>
